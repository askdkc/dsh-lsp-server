{
  "name": "@askdkc/dsh-lsp-server",
  "version": "0.1.2",
  "description": "Composite read-only LSP provider for DeepSeek Harness web stacks",
  "type": "module",
  "main": "./lib/provider.js",
  "types": "./lib/types/provider.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/provider.d.ts",
      "default": "./lib/provider.js"
    },
    "./provider": {
      "types": "./lib/types/provider.d.ts",
      "default": "./lib/provider.js"
    },
    "./extra-tool": {
      "types": "./lib/types/extra-tool.d.ts",
      "default": "./lib/extra-tool.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-lsp-webstack": "./lib/cli/doctor.js"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "README.md",
    "docs/**",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run test:package",
    "test:package": "vitest run --config vitest.package.config.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@tailwindcss/language-server": "0.16.0",
    "svelte-language-server": "0.17.15",
    "typescript": "5.7.3",
    "typescript-language-server": "4.3.3",
    "vscode-langservers-extracted": "4.10.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-lsp": "0.0.1-rc.1 || ^0.1.3-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-fs": "0.0.1-rc.1 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-subprocess": "0.0.1-rc.1 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.0.1-rc.1 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-tool-lsp": "0.0.1-rc.1 || ^0.1.3-alpha.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "tsdown": "0.15.0",
    "typescript": "5.7.3",
    "vitest": "3.2.6",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-lsp": "0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-fs": "0.0.1-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.0.1-rc.1",
    "@deepseek-ai/dsh-tool-lsp": "0.0.1-rc.1",
    "@deepseek-ai/dsh-brand": "0.0.1-rc.1",
    "@deepseek-ai/dsh-invariants": "0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.0.1-rc.1",
    "@deepseek-ai/dsh-timeout": "0.0.1-rc.1",
    "@deepseek-ai/dsh-scope": "0.0.1-rc.1",
    "@deepseek-ai/dsh-session": "0.0.1-rc.1",
    "@deepseek-ai/dsh-fs-local": "0.0.1-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.0.1-rc.1",
    "tailwindcss-v3": "npm:tailwindcss@3.4.17",
    "tailwindcss-v4": "npm:tailwindcss@4.1.13"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "tsdown>rolldown": "1.0.0-beta.38",
      "svelte-language-server>svelte": "5.55.7",
      "vite": "6.4.3"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askdkc/dsh-lsp-server.git"
  },
  "overrides": {
    "tsdown": {
      "rolldown": "1.0.0-beta.38"
    },
    "svelte-language-server": {
      "svelte": "5.55.7"
    },
    "vite": "6.4.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-lsp": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-lsp": {
      "optional": true
    }
  }
}
