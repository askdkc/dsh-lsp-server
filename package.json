{
  "name": "@askdkc/dsh-lsp-webstack",
  "version": "0.1.0-alpha.1",
  "description": "Composite read-only LSP provider for DeepSeek Harness web stacks",
  "type": "module",
  "main": "./lib/provider.js",
  "types": "./lib/types/provider.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/provider.d.ts",
      "default": "./lib/provider.js"
    },
    "./provider": {
      "types": "./lib/types/provider.d.ts",
      "default": "./lib/provider.js"
    },
    "./extra-tool": {
      "types": "./lib/types/extra-tool.d.ts",
      "default": "./lib/extra-tool.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-lsp-webstack": "./lib/cli/doctor.js"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepack": "pnpm check"
  },
  "dependencies": {
    "@tailwindcss/language-server": "0.16.0",
    "svelte-language-server": "0.17.15",
    "typescript": "5.7.3",
    "typescript-language-server": "4.3.3",
    "vscode-langservers-extracted": "4.10.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-lsp": "0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "tsdown": "0.15.0",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
